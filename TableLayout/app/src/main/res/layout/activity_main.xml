<?xml version="1.0" encoding="utf-8"?>
<TableLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9E5"
    android:padding="24dp"
    android:stretchColumns="1"
    tools:context=".MainActivity">

    <!-- 첫 번째 행: 거북이 개수 입력 및 이미지 -->
    <TableRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="center_vertical">

        <!-- 숫자를 입력하는 에디트 텍스트 (배경을 bg.png로 지정) -->
        <EditText
            android:id="@+id/editTurtle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg"
            android:gravity="center"
            android:inputType="number"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 거북이 이미지 뷰 -->
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:src="@drawable/turtle"
            android:contentDescription="거북이 그림" />
    </TableRow>

    <!-- 두 번째 행: 물고기 개수 입력 및 이미지 -->
    <TableRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:gravity="center_vertical">

        <!-- 숫자를 입력하는 에디트 텍스트 -->
        <EditText
            android:id="@+id/editFish"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg"
            android:gravity="center"
            android:inputType="number"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 물고기 이미지 뷰 -->
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:src="@drawable/fish"
            android:contentDescription="물고기 그림" />
    </TableRow>

    <!-- 세 번째 행: 결과보기 버튼 -->
    <TableRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_span="2"
            android:backgroundTint="#00BCD4"
            android:text="결과보기"
            android:textColor="#FFFFFF"
            android:onClick="onResultClick" />
    </TableRow>

</TableLayout>